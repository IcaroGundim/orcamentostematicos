+import { describe, expect, it } from 'vitest';
+import { hashPassword, isHashed, verifyPassword } from './password';
+
+describe('hash de senhas', () => {
+  it('grava em hash e confere a senha certa', async () => {
+    const stored = await hashPassword('abc12345');
+    expect(isHashed(stored)).toBe(true);
+    expect(stored).not.toContain('abc12345');
+    expect(await verifyPassword('abc12345', stored)).toEqual({ ok: true, needsUpgrade: false });
+  });
+
+  it('recusa a senha errada', async () => {
+    const stored = await hashPassword('abc12345');
+    expect(await verifyPassword('abc12346', stored)).toEqual({ ok: false, needsUpgrade: false });
+  });
+
+  it('usa sal: a mesma senha gera hashes diferentes', async () => {
+    expect(await hashPassword('igual')).not.toBe(await hashPassword('igual'));
+  });
+
+  it('aceita o formato antigo (texto puro) e pede a regravação só se conferir', async () => {
+    expect(await verifyPassword('admin123', 'admin123')).toEqual({ ok: true, needsUpgrade: true });
+    expect(await verifyPassword('outra', 'admin123')).toEqual({ ok: false, needsUpgrade: false });
+  });
+
+  it('não trata uma senha antiga com $ como hash malformado que passa', async () => {
+    // Texto puro que apenas contém "$" continua sendo texto puro.
+    expect(await verifyPassword('a$b$c', 'a$b$c')).toEqual({ ok: true, needsUpgrade: true });
+  });
+
+  it('recusa hash adulterado ou com custo absurdo, sem estourar memória', async () => {
+    expect(await verifyPassword('x', 'scrypt$32768$8$1$')).toEqual({ ok: false, needsUpgrade: false });
+    expect(await verifyPassword('x', 'scrypt$1073741824$8$1$c2Fs$aGFzaA')).toEqual({
+      ok: false,
+      needsUpgrade: false,
+    });
+  });
+
+  it('pede regravação quando o custo guardado é menor que o atual', async () => {
+    // Hash válido de "abc" com N = 2^14 (custo antigo), gerado pelo próprio scrypt.
+    const { scryptSync, randomBytes } = await import('node:crypto');
+    const salt = randomBytes(16);
+    const key = scryptSync('abc', salt, 32, { N: 2 ** 14, r: 8, p: 1 });
+    const stored = ['scrypt', 2 ** 14, 8, 1, salt.toString('base64url'), key.toString('base64url')].join('$');
+    expect(await verifyPassword('abc', stored)).toEqual({ ok: true, needsUpgrade: true });
+    expect(await verifyPassword('abd', stored)).toEqual({ ok: false, needsUpgrade: false });
+  });
+
+  it('normaliza Unicode: "ã" composto e decomposto são a mesma senha', async () => {
+    const stored = await hashPassword('coração');
+    expect((await verifyPassword('coração', stored)).ok).toBe(true);
+    expect((await verifyPassword('coração', stored)).ok).toBe(true);
+  });
+});

+// Migra as senhas que ainda estão em TEXTO PURO para hash (scrypt).
+//
+// Uso (em apps/web):  node scripts/hash-passwords.mjs            # só relata (dry-run)
+//                     node scripts/hash-passwords.mjs --apply    # grava, pedindo confirmação
+//                     node scripts/hash-passwords.mjs --apply --yes
+//
+// Não muda o schema (a coluna `User.password` continua `String`): o app já aceita
+// os dois formatos (`src/lib/password.ts`) e regrava no primeiro login de cada
+// conta. Este script só antecipa isso para as contas dormentes.
+//
+// Por que NÃO há backup obrigatório aqui, ao contrário de `db:push`: `db:backup`
+// não inclui a tabela `User` (e não deve — um backup dela seria um arquivo de senhas
+// em texto puro dentro do git). A operação é idempotente e só toca linhas que ainda
+// não começam com `scrypt$`; o pior caso (hash gravado errado) se resolve com
+// "Esqueci minha senha" ou pela tela Usuários, e são poucas contas.
+//
+// Segurança do próprio script:
+//   - nunca imprime uma senha, nem em hash; só ids, e-mails e contagens;
+//   - cada UPDATE é um compare-and-swap (`WHERE password = <valor lido>`): se a senha
+//     mudou no meio do caminho (redefinição, edição pelo admin), a linha é pulada.
+
+import readline from 'node:readline';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import pg from 'pg';
+import { config } from 'dotenv';
+// Node 22.18+ executa .ts direto (type stripping); o módulo só usa sintaxe apagável.
+import { hashPassword, isHashed } from '../src/lib/password.ts';
+
+const webDir = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+config({ path: path.resolve(webDir, '.env.local'), quiet: true });
+config({ path: path.resolve(webDir, '.env'), quiet: true });
+
+const args = process.argv.slice(2);
+const APPLY = args.includes('--apply');
+const SKIP_CONFIRM = args.includes('--yes');
+
+// Senhas do seed (README e prisma/seed.ts): públicas no repositório.
+const SEED_DEFAULTS = new Set(['admin123', 'secretaria123']);
+
+if (!process.env.DATABASE_URL) {
+  console.error('Defina DATABASE_URL.');
+  process.exit(1);
+}
+
+function ask(question) {
+  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
+  return new Promise((resolve) => rl.question(question, (answer) => { rl.close(); resolve(answer); }));
+}
+
+const client = new pg.Client({ connectionString: process.env.DATABASE_URL });
+await client.connect();
+
+try {
+  const { rows } = await client.query('SELECT id, email, active, password FROM "User" ORDER BY email');
+  const legacy = rows.filter((row) => !isHashed(row.password));
+  const hashed = rows.length - legacy.length;
+  const withSeedPassword = legacy.filter((row) => SEED_DEFAULTS.has(row.password));
+
+  console.log(`Usuários: ${rows.length}  |  já em hash: ${hashed}  |  em texto puro: ${legacy.length}`);
+  if (withSeedPassword.length > 0) {
+    console.log(`\n⚠ ${withSeedPassword.length} conta(s) ainda usam a senha padrão do seed (pública no repositório):`);
+    for (const row of withSeedPassword) console.log(`   - ${row.email}${row.active ? '' : ' (inativa)'}`);
+    console.log('  Troque essas senhas pela tela Usuários; hashear não as torna secretas.');
+  }
+
+  if (legacy.length === 0) {
+    console.log('\nNada a migrar.');
+  } else if (!APPLY) {
+    console.log('\nDry-run: nada foi gravado. Rode com --apply para migrar.');
+  } else {
+    if (!SKIP_CONFIRM) {
+      const answer = await ask(`\nGravar hash em ${legacy.length} conta(s)? Digite "sim" para confirmar: `);
+      if (answer.trim().toLowerCase() !== 'sim') {
+        console.log('Cancelado.');
+        process.exit(0);
+      }
+    }
+    let migrated = 0;
+    let skipped = 0;
+    for (const row of legacy) {
+      const result = await client.query(
+        'UPDATE "User" SET password = $1 WHERE id = $2 AND password = $3',
+        [await hashPassword(row.password), row.id, row.password],
+      );
+      if (result.rowCount === 1) migrated += 1;
+      else skipped += 1; // a senha mudou depois da leitura
+    }
+    console.log(`\nMigradas: ${migrated}  |  puladas (senha mudou no meio): ${skipped}`);
+    if (skipped > 0) console.log('Rode de novo para pegar as puladas.');
+  }
+} finally {
+  await client.end();
+}

+/**
+ * Hash de senhas (scrypt, `node:crypto`) — sem dependência nova.
+ *
+ * Formato armazenado em `User.password`:
+ *
+ *     scrypt$<N>$<r>$<p>$<salt base64url>$<hash base64url>
+ *
+ * Os parâmetros vão dentro da própria string: subir o custo no futuro não invalida
+ * ninguém — `verifyPassword` lê o custo antigo e devolve `needsUpgrade`, e o login
+ * regrava no custo novo.
+ *
+ * MIGRAÇÃO SEM SCHEMA NOVO. A coluna continua `String`; um valor que não começa com
+ * `scrypt$` é uma senha antiga, ainda em texto puro. `verifyPassword` aceita os dois
+ * formatos, e `needsUpgrade` diz ao chamador que vale regravar em hash depois de um
+ * login bem-sucedido. Enquanto o script `hash-passwords.mjs` não rodar, contas
+ * dormentes seguem no formato antigo.
+ *
+ * Sem `server-only` de propósito: o seed e o script de migração rodam fora do Next.
+ */
+import { createHash, randomBytes, scrypt, timingSafeEqual } from 'node:crypto';
+
+const PREFIX = 'scrypt';
+
+/** Custo atual. N = 2^15 e r = 8 pedem ~32 MiB e levam ~80–150 ms por hash. */
+const COST = { N: 2 ** 15, r: 8, p: 1 } as const;
+const KEY_BYTES = 32;
+const SALT_BYTES = 16;
+
+/**
+ * Teto do comprimento aceito. O custo do scrypt cresce com a senha (via PBKDF2
+ * interno); sem teto, um corpo gigante vira negação de serviço num endpoint público.
+ */
+export const MAX_PASSWORD_LENGTH = 1024;
+
+type Cost = { N: number; r: number; p: number };
+
+function derive(password: string, salt: Buffer, cost: Cost, keyBytes: number): Promise<Buffer> {
+  return new Promise((resolve, reject) => {
+    scrypt(
+      // NFKC: o mesmo "ã" digitado composto ou decomposto gera o mesmo hash.
+      password.normalize('NFKC'),
+      salt,
+      keyBytes,
+      // `maxmem` padrão (32 MiB) é justo para N = 2^15; 128·N·r·2 dá folga.
+      { N: cost.N, r: cost.r, p: cost.p, maxmem: 128 * cost.N * cost.r * 2 },
+      (error, key) => (error ? reject(error) : resolve(key)),
+    );
+  });
+}
+
+export function isHashed(stored: string): boolean {
+  return stored.startsWith(`${PREFIX}$`);
+}
+
+export async function hashPassword(password: string): Promise<string> {
+  const salt = randomBytes(SALT_BYTES);
+  const key = await derive(password, salt, COST, KEY_BYTES);
+  return [PREFIX, COST.N, COST.r, COST.p, salt.toString('base64url'), key.toString('base64url')].join('$');
+}
+
+function parseHash(stored: string): { cost: Cost; salt: Buffer; key: Buffer } | null {
+  const [prefix, n, r, p, salt, key] = stored.split('$');
+  if (prefix !== PREFIX || !n || !r || !p || !salt || !key) return null;
+  const cost = { N: Number(n), r: Number(r), p: Number(p) };
+  if (![cost.N, cost.r, cost.p].every((value) => Number.isInteger(value) && value > 0)) return null;
+  // Um valor adulterado no banco não pode pedir gigabytes de memória.
+  if (cost.N > 2 ** 20 || cost.r > 32 || cost.p > 16) return null;
+  const saltBuffer = Buffer.from(salt, 'base64url');
+  const keyBuffer = Buffer.from(key, 'base64url');
+  if (saltBuffer.length === 0 || keyBuffer.length === 0) return null;
+  return { cost, salt: saltBuffer, key: keyBuffer };
+}
+
+/** Comparação em tempo constante que também não revela o comprimento. */
+function constantTimeEqual(a: string, b: string): boolean {
+  const digestA = createHash('sha256').update(a).digest();
+  const digestB = createHash('sha256').update(b).digest();
+  return timingSafeEqual(digestA, digestB);
+}
+
+export type PasswordCheck = {
+  ok: boolean;
+  /** Login válido, mas o valor guardado é texto puro ou tem custo antigo: regravar. */
+  needsUpgrade: boolean;
+};
+
+/** Confere `password` contra o valor de `User.password`, em hash ou em texto puro. */
+export async function verifyPassword(password: string, stored: string): Promise<PasswordCheck> {
+  if (!isHashed(stored)) {
+    // Formato antigo: texto puro. Só vale regravar se a senha conferir.
+    const ok = constantTimeEqual(password, stored);
+    return { ok, needsUpgrade: ok };
+  }
+  const parsed = parseHash(stored);
+  if (!parsed) return { ok: false, needsUpgrade: false };
+
+  const key = await derive(password, parsed.salt, parsed.cost, parsed.key.length);
+  const ok = key.length === parsed.key.length && timingSafeEqual(key, parsed.key);
+  const outdated =
+    parsed.cost.N !== COST.N ||
+    parsed.cost.r !== COST.r ||
+    parsed.cost.p !== COST.p ||
+    parsed.key.length !== KEY_BYTES;
+  return { ok, needsUpgrade: ok && outdated };
+}
+
+let dummyHash: Promise<string> | null = null;
+
+/**
+ * Gasta o mesmo tempo de uma verificação real. Sem isso, "usuário inexistente"
+ * responderia em microssegundos e "senha errada" em ~100 ms — e o tempo de
+ * resposta passaria a revelar quais e-mails têm conta.
+ */
+export async function spendVerificationTime(password: string): Promise<void> {
+  dummyHash ??= hashPassword('senha-descartavel-para-igualar-o-tempo');
+  await verifyPassword(password, await dummyHash);
+}

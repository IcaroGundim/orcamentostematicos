{
  "name": "@orcamentos-tematicos/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:backup": "node scripts/backup.mjs",
    "db:push": "node scripts/safe-push.mjs",
    "db:diff": "prisma migrate diff --from-schema ./prisma/schema.prisma --to-config-datasource ./prisma.config.ts --script",
    "geo:acre": "npx --yes mapshaper@0.7.45 ../../shapefile/AC_Municipios_2025.shp -simplify 8% keep-shapes -filter-fields CD_MUN,NM_MUN -o force format=geojson precision=0.00001 public/maps/acre-municipalities-2025.geojson"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-table": "latest",
    "@tanstack/react-virtual": "^3.13.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "next": "latest",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "radix-ui": "^1.4.3",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "recharts": "^3.8.0",
    "resend": "^4.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/leaflet": "^1.9.21",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "react-grab": "^0.1.37",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SEPLAN_ADMIN
  SECRETARIA_REPRESENTANTE
}

enum ThemeBudget {
  OCAD
  OSG
  CLIMATICO
}

enum AssignmentStatus {
  RASCUNHO
  PRONTO_PARA_VALIDACAO
  ARQUIVADO
}

enum ValidationStatus {
  RASCUNHO
  ENVIADO
  DEVOLVIDO
  APROVADO
}

enum QddPeriodType {
  MES_ISOLADO
  ACUMULADO_ANUAL
}

enum GovernmentEntityType {
  SECRETARIA
  AUTARQUIA
  FUNDACAO
  EMPRESA_PUBLICA
  FUNDO
  OUTRO
}

model GovernmentOrganization {
  code      String               @id
  name      String
  type      GovernmentEntityType @default(SECRETARIA)
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  units GovernmentUnit[]
}

model GovernmentUnit {
  organizationCode String
  code             String
  name             String
  active           Boolean  @default(true)
  relocated        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization GovernmentOrganization @relation(fields: [organizationCode], references: [code], onDelete: Cascade)

  @@id([organizationCode, code])
  @@index([organizationCode])
}

model UnitExecutor {
  organizationCode String
  unitCode         String
  executorOrgCode  String
  executorUnitCode String?

  @@id([organizationCode, unitCode])
  @@index([executorOrgCode, executorUnitCode])
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  username         String?   @unique
  password         String
  role             UserRole
  organizationCode String?
  unitCode         String?
  active           Boolean   @default(true)
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())

  sessions            Session[]
  assignments         ThematicAssignment[]
  activityLogs        UserActivityLog[]
  passwordResetTokens PasswordResetToken[]
}

model UserActivityLog {
  id               String   @id @default(cuid())
  userId           String
  action           String
  entityType       String?
  entityId         String?
  organizationCode String?
  unitCode         String?
  metadata         Json?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Session {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  token     String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BudgetImport {
  id             String        @id @default(cuid())
  filename       String
  year           Int
  referenceMonth Int
  periodType     QddPeriodType
  importedAt     DateTime      @default(now())
  rowCount       Int
  actionCount    Int
  status         String        @default("VIGENTE")

  actions BudgetAction[]
}

model BudgetAction {
  id                String @id @default(cuid())
  importId          String
  year              Int
  organizationCode  String
  organizationName  String
  unitCode          String
  unitName          String
  application       String
  functionalProgram String
  projectActivity   String

  initialBudget Float @default(0)
  supplemented  Float @default(0)
  updatedBudget Float @default(0)
  committed     Float @default(0)
  liquidated    Float @default(0)
  paid          Float @default(0)
  available     Float @default(0)

  import       BudgetImport         @relation(fields: [importId], references: [id], onDelete: Cascade)
  expenseLines ExpenseLine[]
  assignments  ThematicAssignment[]
  validations  ActionValidation[]

  @@index([importId])
  @@index([organizationCode])
}

model ExpenseLine {
  id                 String @id @default(cuid())
  actionId           String
  organizationCode   String
  organizationName   String
  unitCode           String
  unitName           String
  application        String
  functionalProgram  String
  projectActivity    String
  expenseAccount     String
  expenseDescription String
  reduced            String
  source             String

  initialBudget      Float @default(0)
  supplemented       Float @default(0)
  updatedBudget      Float @default(0)
  committed          Float @default(0)
  liquidated         Float @default(0)
  payableToLiquidate Float @default(0)
  paid               Float @default(0)
  payable            Float @default(0)
  available          Float @default(0)

  action BudgetAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
}

model ThematicAssignment {
  id              String           @id @default(cuid())
  actionId        String
  theme           ThemeBudget
  axis            String
  classification  String
  weightingFactor Float?
  justification   String?
  status          AssignmentStatus @default(PRONTO_PARA_VALIDACAO)
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  action        BudgetAction       @relation(fields: [actionId], references: [id], onDelete: Cascade)
  createdByUser User               @relation(fields: [createdBy], references: [id])
  validations   ActionValidation[]

  @@index([actionId])
}

model ValidationCycle {
  id       String      @id @default(cuid())
  name     String
  year     Int
  theme    ThemeBudget
  status   String      @default("ABERTO")
  openedAt DateTime    @default(now())
  closedAt DateTime?

  validations ActionValidation[]
}

model ImportPreview {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
}

/// Folha de pagamento do Estado, coletada do Portal da Transparência.
/// Guarda SOMENTE agregados — nenhum nome, matrícula ou dado pessoal é persistido.
/// Um registro por mês de referência; a coleta substitui o mês inteiro.
model PayrollSnapshot {
  id          String   @id @default(cuid())
  year        Int
  month       Int
  collectedAt DateTime @default(now())

  headcount       Int
  /// Total informado pelo portal sem filtro — permite auditar a diferença em relação
  /// a `headcount`, já que vínculos sem tipo de contrato não podem ser isolados.
  portalHeadcount Int
  grossTotal      Float @default(0)
  deductionsTotal Float @default(0)
  netTotal        Float @default(0)

  groups PayrollGroup[]

  @@unique([year, month])
}

enum PayrollDimension {
  CONTRACT_TYPE
  ORGANIZATION
  CAREER
  ORGANIZATION_CONTRACT
}

/// Uma linha agregada da folha. `dimension` diz por qual recorte ela foi somada;
/// `key` é o valor do recorte (ex.: "EFETIVO", "SECRETARIA DE ESTADO DE SAUDE") e
/// `secondaryKey` só é usado no cruzamento órgão × tipo de contrato.
model PayrollGroup {
  id           String           @id @default(cuid())
  snapshotId   String
  dimension    PayrollDimension
  key          String
  secondaryKey String?

  headcount       Int
  grossTotal      Float @default(0)
  deductionsTotal Float @default(0)
  netTotal        Float @default(0)

  snapshot PayrollSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, dimension])
}

model ActionValidation {
  id                    String           @id @default(cuid())
  cycleId               String
  actionId              String
  assignmentId          String
  organizationCode      String
  unitCode              String
  theme                 ThemeBudget
  status                ValidationStatus @default(RASCUNHO)
  executionStatus       String?
  realizedDescription   String?
  informedExecutedValue Float?
  observations          String?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewerComment       String?
  updatedAt             DateTime         @updatedAt

  deliveries Json @default("[]")
  evidences  Json @default("[]")

  cycle      ValidationCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  action     BudgetAction       @relation(fields: [actionId], references: [id])
  assignment ThematicAssignment @relation(fields: [assignmentId], references: [id])

  @@index([cycleId])
  @@index([organizationCode])
}

/// Política do exercício financeiro. Uma linha por exercício; a AUSÊNCIA de linha
/// significa exercício completo (entregas habilitadas), então nada precisa ser
/// semeado para os exercícios que já existiam.
model FiscalYear {
  year           Int      @id
  /// Exercício corrente: o que recebe entregas das secretarias. Marcado
  /// explicitamente pela SEPLAN — trocar é ato de governança, não navegação.
  /// Enquanto NENHUM ano estiver marcado, vale o ano mais recente com QDD vigente,
  /// que é o comportamento anterior (por isso nada precisou ser semeado).
  isCurrent      Boolean  @default(false)
  /// Exercício carregado apenas para comparação: recebe execução e marcações
  /// temáticas, mas NÃO gera ciclos de validação nem entregas.
  comparisonOnly Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Estrutura de governo POR EXERCÍCIO. Substitui `GovernmentOrganization`,
/// `GovernmentUnit` e `UnitExecutor`, que não tinham ano — nelas o campo `active`
/// significava "presente no único QDD vigente" e perdia o sentido com mais de um
/// exercício. As tabelas antigas seguem no banco como rede de segurança até uma
/// remoção deliberada.
model ExerciseOrganization {
  year      Int
  code      String
  name      String
  type      GovernmentEntityType @default(SECRETARIA)
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  units ExerciseUnit[]

  @@id([year, code])
}

model ExerciseUnit {
  year             Int
  organizationCode String
  code             String
  name             String
  active           Boolean  @default(true)
  /// Anotação manual da SEPLAN para desambiguar unidade remanejada entre órgãos.
  relocated        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization ExerciseOrganization @relation(fields: [year, organizationCode], references: [year, code], onDelete: Cascade)

  @@id([year, organizationCode, code])
  @@index([year, organizationCode])
}

/// Quem executa cada unidade, por exercício. Sem FK para `ExerciseUnit`: o padrão
/// é criado a partir das ações importadas, que podem trazer pares ainda ausentes
/// do cadastro.
model ExerciseUnitExecutor {
  year             Int
  organizationCode String
  unitCode         String
  executorOrgCode  String
  executorUnitCode String?

  @@id([year, organizationCode, unitCode])
  @@index([year, executorOrgCode, executorUnitCode])
}

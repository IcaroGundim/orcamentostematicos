# Copie para .env.local e preencha DATABASE_URL.
# Na Vercel: Project → Settings → Environment Variables → DATABASE_URL (Production) → Reveal.
# Ou no painel Neon: Connection string do projeto vinculado ao deploy.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Recuperação de senha por e-mail (Resend — https://resend.com).
# RESEND_API_KEY: chave da conta Resend (tier gratuito atende ao volume).
# RESEND_FROM: remetente verificado. Sem domínio próprio, use "onboarding@resend.dev".
# APP_URL: base usada no link do e-mail; se vazio, derivamos da própria requisição.
RESEND_API_KEY=""
RESEND_FROM="Orçamentos Temáticos <onboarding@resend.dev>"
APP_URL=""
